# ---------------------------------------------------------------------------
# VTU RAG Assistant — environment configuration
# Copy to .env:  cp .env.example .env
# Defaults work out of the box with `docker compose up --build`.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Root of the notes tree: <DATA_DIR>/<branch>/<scheme>/<semester>/<subject_code>/moduleN.pdf
DATA_DIR=/app/data
# Defaults used by the UI and as fallbacks for ingestion
DEFAULT_BRANCH=cse
DEFAULT_SCHEME=2022

# --- Host ports (change if something else on your machine uses them) -----
POSTGRES_HOST_PORT=5432
OPENSEARCH_HOST_PORT=9200
REDIS_HOST_PORT=6379
OLLAMA_HOST_PORT=11434
API_HOST_PORT=8000
GRADIO_HOST_PORT=7860
AIRFLOW_HOST_PORT=8080
LANGFUSE_HOST_PORT=3000
DASHBOARDS_HOST_PORT=5601

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vtu
POSTGRES_PASSWORD=vtu_password
POSTGRES_DB=vtu_rag

# --- OpenSearch ------------------------------------------------------------
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX=vtu-note-chunks
OPENSEARCH_SEARCH_PIPELINE=vtu-hybrid-pipeline
# Weight of the BM25 leg vs the vector leg in hybrid score combination
OPENSEARCH_BM25_WEIGHT=0.3
OPENSEARCH_VECTOR_WEIGHT=0.7

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# --- Embeddings (Jina AI) --------------------------------------------------
# Free key: https://jina.ai/embeddings  — without a key, search falls back to BM25 only.
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
JINA_DIMENSIONS=1024

# --- Chunking --------------------------------------------------------------
CHUNK_TARGET_WORDS=350
CHUNK_OVERLAP_WORDS=60
CHUNK_MIN_WORDS=80

# --- LLM -------------------------------------------------------------------
# ollama (default) | groq | together | openai_compatible
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180

OLLAMA_HOST=http://ollama:11434
# Docker image tag for ollama/ollama (pin to a version you already have to skip a pull)
OLLAMA_IMAGE_TAG=latest
# Fits comfortably in 6 GB VRAM. Try qwen2.5:7b or llama3.1:8b on bigger GPUs.
OLLAMA_MODEL=llama3.2:3b

# Only needed when LLM_PROVIDER is not ollama
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=

# --- Agent -----------------------------------------------------------------
AGENT_MAX_REWRITES=2
AGENT_GUARDRAIL_THRESHOLD=50
AGENT_TOP_K=5

# --- Langfuse (optional; tracing is disabled when keys are blank) ----------
# Create keys in the Langfuse UI at http://localhost:3000 after first start.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret
LANGFUSE_SALT=change-me-salt

# --- Gradio UI -------------------------------------------------------------
API_BASE_URL=http://api:8000

# --- Airflow ---------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# How often the re-index DAG scans DATA_DIR for new/changed notes
REINDEX_SCHEDULE=*/30 * * * *

# --- Telegram (optional; `docker compose --profile telegram up`) -----------
TELEGRAM_BOT_TOKEN=
